{
  "description": "Keyword fallback data for the router, used only when every LLM provider fails or no key is set. Words map to vocab ids; nothing here is a device name.",
  "out_of_scope": [
    "weapon", "weapons", "gun", "guns", "firearm", "rifle", "explosive", "explosives", "bomb",
    "jammer", "jamming", "jam", "taser", "stun gun",
    "diagnose", "diagnosis", "diagnostic", "medical device", "pacemaker", "insulin",
    "mains", "230v", "220v", "120v", "110v", "wall outlet appliance",
    "rideable", "e-bike", "ebike", "electric scooter", "go kart", "go-kart",
    "time machine", "perpetual motion", "teleporter", "anti gravity", "antigravity"
  ],
  "skip_answers": ["just pick", "whatever", "you decide", "you choose", "anything", "dont care", "don't care", "no preference", "surprise me"],
  "function_words": {
    "keyboard": ["input.key_matrix"],
    "keypad": ["input.key_matrix"],
    "macropad": ["input.key_matrix"],
    "key": ["input.key_matrix"],
    "keys": ["input.key_matrix"],
    "button": ["input.button"],
    "buttons": ["input.button"],
    "knob": ["input.rotary_encoder"],
    "encoder": ["input.rotary_encoder"],
    "joystick": ["input.joystick"],
    "trackball": ["input.trackball"],
    "oled": ["display.oled"],
    "screen": ["display.oled"],
    "display": ["display.oled"],
    "epaper": ["display.epaper"],
    "e-ink": ["display.epaper"],
    "lcd": ["display.tft"],
    "thermometer": ["sense.temperature"],
    "temperature": ["sense.temperature"],
    "humidity": ["sense.humidity"],
    "weather": ["sense.temperature", "sense.humidity"],
    "co2": ["sense.co2"],
    "air quality": ["sense.particulate"],
    "light sensor": ["sense.light"],
    "motion": ["sense.presence"],
    "soil": ["sense.soil_moisture"],
    "plant": ["sense.soil_moisture"],
    "distance": ["sense.distance"],
    "led": ["output.rgb_led"],
    "leds": ["output.rgb_led"],
    "lamp": ["output.rgb_led"],
    "light": ["output.rgb_led"],
    "speaker": ["output.speaker"],
    "buzzer": ["output.buzzer"],
    "motor": ["output.motor_dc"],
    "servo": ["output.motor_servo"],
    "fan": ["output.fan"],
    "clock": ["display.seven_segment"],
    "wireless": ["comms.ble"],
    "bluetooth": ["comms.ble"],
    "ble": ["comms.ble"],
    "wifi": ["comms.wifi"],
    "wi-fi": ["comms.wifi"],
    "battery": ["power.battery"]
  },
  "device_class_by_function_group": {
    "input": "input_device",
    "sense": "sensor_station",
    "display": "display_device",
    "output": "lighting"
  },
  "facet_words": {
    "wireless": ["wireless", "ble"],
    "bluetooth": ["wireless", "ble"],
    "wired": ["wireless", "none"],
    "split": ["split", true],
    "choc": ["switch_family", "choc_v1"],
    "mx": ["switch_family", "mx"],
    "60%": ["layout_size", "percent_60"],
    "oled": ["display_type", "oled"],
    "battery": ["power_source", "battery"],
    "usb powered": ["power_source", "usb"]
  }
}
