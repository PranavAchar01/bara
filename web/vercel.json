{
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "VITE_ENGINE_DISCOVERY=1 pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/build", "destination": "/index.html" },
    { "source": "/build/(.*)", "destination": "/index.html" },
    { "source": "/library", "destination": "/index.html" },
    { "source": "/drafts", "destination": "/index.html" }
  ]
}
