{
  "actorSpecification": 1,
  "name": "bara-hardware-scout",
  "title": "Open Hardware Scout (KiCad projects and priced parts)",
  "description": "Describe a device or a part function. Get public open-source KiCad projects (licence detected, board and case files, README, LCSC part numbers) and live price and stock for the parts they use.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "../Dockerfile",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "designs": {
          "title": "Open-source designs",
          "transformation": {"fields": ["name", "repo", "licence", "stars", "fit", "kicad_pcb", "enclosure_files", "lcsc_ids"]},
          "display": {"component": "table"}
        },
        "parts": {
          "title": "Priced parts",
          "transformation": {"fields": ["lcsc_id", "mpn", "package", "unit_price_usd", "stock", "product_url"]},
          "display": {"component": "table"}
        }
      }
    }
  }
}
