{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.invalid/spec/v1/part.schema.json",
  "x-spec-version": "1.1.0",
  "title": "Part",
  "description": "One sourced part. Strict superset of the Etch record in pcb-loop/engine/parts/kicad_library.json: every Etch field keeps its name and type (block 1). Block 2 adds what makes a part Lego shaped: functions, typed interfaces, ratings, mechanics, drivers, assets, structured licence. For Etch imported parts part_id equals key.",
  "type": "object",
  "required": [
    "part_id",
    "kind",
    "display_name",
    "functions",
    "interfaces",
    "licence",
    "provenance"
  ],
  "properties": {
    "key": {
      "type": "string",
      "description": "Etch: unique key, for example kicad:4xxx:14528@DIP-16_W10.16mm."
    },
    "lib_id": {
      "type": "string",
      "description": "Etch: KiCad symbol id."
    },
    "footprint": {
      "type": "string",
      "description": "Etch: KiCad footprint id, for example Package_DIP:DIP-16_W10.16mm."
    },
    "family": {
      "type": "string",
      "description": "Etch: library family."
    },
    "name": {
      "type": "string",
      "description": "Etch: symbol / footprint name."
    },
    "descr": {
      "type": "string",
      "description": "Etch: description."
    },
    "kw": {
      "type": "string",
      "description": "Etch: keywords."
    },
    "pins": {
      "type": "object",
      "description": "Etch: pin number to pin name.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "pads_ok": {
      "type": "boolean",
      "description": "Etch."
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "description": "Etch: server local STEP path. Never sent to the browser as a URL; use assets."
    },
    "spice": {
      "type": "object",
      "description": "Etch.",
      "properties": {
        "prefix": {
          "type": "string"
        },
        "pins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "spice_note": {
      "type": "string",
      "description": "Etch."
    },
    "datasheet": {
      "type": "string",
      "description": "Etch: datasheet URL or empty string."
    },
    "source": {
      "type": "string",
      "description": "Etch: library source, for example kicad-lib or extra:sparkfun-kicad."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Etch."
    },
    "fp_ok": {
      "type": "boolean",
      "description": "Etch."
    },
    "part_id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "kind": {
      "type": "string",
      "description": "module: a ready board (breakout, dev board, display module). component: a bare electronic part. pcb: a whole board from an open design. mechanical: plate, keycap, case part. fastener: screws, standoffs, nuts. cable: wires and cables.",
      "enum": [
        "module",
        "component",
        "pcb",
        "mechanical",
        "fastener",
        "cable",
        "other",
        "unknown"
      ]
    },
    "display_name": {
      "type": "string",
      "maxLength": 80,
      "description": "Short UI name, for example nice!nano v2."
    },
    "mpn": {
      "type": [
        "string",
        "null"
      ]
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ]
    },
    "vendor_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "description": "One line for the part card."
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "function_id"
        ],
        "properties": {
          "function_id": {
            "$ref": "vocab.schema.json#/$defs/FunctionId"
          },
          "primary": {
            "type": "boolean",
            "default": false
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "$ref": "interface.schema.json"
      }
    },
    "electrical": {
      "type": "object",
      "properties": {
        "v_in_min_v": {
          "type": "number"
        },
        "v_in_max_v": {
          "type": "number"
        },
        "v_logic_v": {
          "type": "number"
        },
        "i_typ_a": {
          "type": "number",
          "minimum": 0
        },
        "i_max_a": {
          "type": "number",
          "minimum": 0
        },
        "i_sleep_a": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "mechanical": {
      "type": "object",
      "properties": {
        "bbox_mm": {
          "$ref": "common.schema.json#/$defs/BBox",
          "description": "In the part's local frame, which equals the GLB frame after the fixed asset transform."
        },
        "mass_g": {
          "type": "number",
          "minimum": 0
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Standard tags such as MX, Qwiic, M2.5, pro_micro, 2.54mm_header."
        },
        "mating_features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "hole",
                  "slot",
                  "boss",
                  "pin",
                  "pad",
                  "connector",
                  "cutout",
                  "unknown"
                ]
              },
              "subtype": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "diameter_mm": {
                "type": "number"
              },
              "thread": {
                "$ref": "vocab.schema.json#/$defs/Screw"
              },
              "axis": {
                "$ref": "common.schema.json#/$defs/Vec3"
              },
              "pos_mm": {
                "$ref": "common.schema.json#/$defs/Vec3"
              }
            }
          }
        },
        "keepouts": {
          "type": "array",
          "description": "Volumes that must stay clear (antenna, connector mating space).",
          "items": {
            "$ref": "common.schema.json#/$defs/BBox"
          }
        }
      }
    },
    "drivers": {
      "type": "array",
      "description": "Per framework driver templates used by the firmware stage.",
      "items": {
        "type": "object",
        "required": [
          "framework",
          "library"
        ],
        "properties": {
          "framework": {
            "$ref": "#/$defs/Framework"
          },
          "library": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "include": {
            "type": [
              "string",
              "null"
            ]
          },
          "class_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "init_snippet": {
            "type": [
              "string",
              "null"
            ]
          },
          "loop_snippet": {
            "type": [
              "string",
              "null"
            ]
          },
          "config_keys": {
            "type": "object",
            "additionalProperties": true,
            "description": "For config based firmware (QMK, ZMK, ESPHome): keys this part adds."
          }
        }
      }
    },
    "render": {
      "type": "object",
      "properties": {
        "default_color": {
          "$ref": "common.schema.json#/$defs/HexColor"
        },
        "material": {
          "$ref": "common.schema.json#/$defs/Material"
        },
        "recolorable_nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "asset.schema.json"
      }
    },
    "licence": {
      "$ref": "provenance.schema.json#/$defs/Licence"
    },
    "provenance": {
      "$ref": "provenance.schema.json#/$defs/Provenance"
    },
    "facets": {
      "type": "object",
      "description": "Flat facet record derived from the fields above, used for filtering. Keys are facet keys from GET /v1/facets.",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "array",
          "null"
        ]
      }
    },
    "compatible_with": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "part_id",
          "relation"
        ],
        "properties": {
          "part_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "relation": {
            "type": "string",
            "enum": [
              "mates_with",
              "drives",
              "used_with",
              "substitute_for",
              "unknown"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ],
            "description": "design_id or rule that established the edge."
          }
        }
      }
    },
    "popularity": {
      "type": "object",
      "properties": {
        "stars": {
          "type": "integer",
          "minimum": 0
        },
        "designs_using": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "unknown"
      ],
      "default": "active"
    }
  },
  "$defs": {
    "Framework": {
      "type": "string",
      "enum": [
        "qmk",
        "zmk",
        "kmk",
        "arduino",
        "circuitpython",
        "micropython",
        "esphome",
        "zephyr",
        "esp_idf",
        "other",
        "unknown"
      ]
    },
    "PartCard": {
      "type": "object",
      "description": "Compact part summary used in lists, candidates and the swap drawer.",
      "required": [
        "part_id",
        "display_name",
        "kind"
      ],
      "properties": {
        "part_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "module",
            "component",
            "pcb",
            "mechanical",
            "fastener",
            "cable",
            "other",
            "unknown"
          ]
        },
        "primary_function": {
          "$ref": "vocab.schema.json#/$defs/FunctionId"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_specs": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "common.schema.json#/$defs/KeySpec"
          }
        },
        "thumbnail_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "licence_spdx": {
          "type": "string"
        },
        "commercial_ok": {
          "$ref": "common.schema.json#/$defs/TriState"
        },
        "verified": {
          "$ref": "provenance.schema.json#/$defs/Verified"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
