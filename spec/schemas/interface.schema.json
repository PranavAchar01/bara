{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.invalid/spec/v1/interface.schema.json",
  "x-spec-version": "1.1.0",
  "title": "Interface",
  "description": "A typed port on a part. params shape depends on type (see vocab.schema.json Params_<type>). Unknown params keys are ignored by clients.",
  "type": "object",
  "required": [
    "id",
    "type",
    "role",
    "params"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Unique within the part, for example i2c0, vin, sw_socket."
    },
    "type": {
      "$ref": "vocab.schema.json#/$defs/InterfaceType"
    },
    "role": {
      "$ref": "vocab.schema.json#/$defs/Role"
    },
    "label": {
      "type": "string",
      "maxLength": 60,
      "description": "Human label for the UI, for example Qwiic port A."
    },
    "params": {
      "type": "object"
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pin numbers (keys of Part.pins) that carry this interface. Empty for mechanical interfaces."
    },
    "signals": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Signal name to pin number, for example {SDA: '2', SCL: '3'}."
    },
    "optional": {
      "type": "boolean",
      "default": false,
      "description": "true when a requires port may stay unconnected without failing slot.critical_filled."
    },
    "max_connections": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "How many peers this port can take. null means limited only by type rules (I2C addresses, current budget)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "power_in"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "vocab.schema.json#/$defs/Params_power_in"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "power_out"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "vocab.schema.json#/$defs/Params_power_out"
          }
        }
      }
    },
    {
