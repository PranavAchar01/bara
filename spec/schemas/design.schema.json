{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.invalid/spec/v1/design.schema.json",
  "x-spec-version": "1.1.0",
  "title": "Design",
  "description": "A complete open hardware design in the catalog (for example Corne). The reuse stage returns one of these as is (exact), with substitutions (substitute), or as the skeleton for compose. Parts, connections and layouts use the same shapes as Build.",
  "type": "object",
  "required": [
    "design_id",
    "name",
    "device_class",
    "taxonomy_path",
    "functions",
    "parts",
    "connections",
    "licence",
    "provenance"
  ],
  "properties": {
    "design_id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "repo_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "device_class": {
      "$ref": "vocab.schema.json#/$defs/DeviceClass"
    },
    "taxonomy_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/Slug"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "vocab.schema.json#/$defs/FunctionId"
      }
    },
    "attributes": {
      "type": "object",
      "description": "Facet record of the design (facet key to value), matched against Spec requirements by the reuse stage.",
      "additionalProperties": true
    },
    "popularity": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "Prior used for underspecified prompts. 1 = most popular in its class."
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "slot.schema.json#/$defs/Slot"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "build.schema.json#/$defs/BuildPart"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "build.schema.json#/$defs/Connection"
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "$ref": "build.schema.json#/$defs/Layout"
      }
    },
    "enclosures": {
      "type": "array",
      "items": {
        "$ref": "build.schema.json#/$defs/Enclosure"
      }
    },
    "boards": {
      "type": "array",
      "items": {
        "$ref": "build.schema.json#/$defs/Board"
      }
    },
    "firmware": {
      "oneOf": [
        {
          "$ref": "build.schema.json#/$defs/Firmware"
        },
        {
          "type": "null"
        }
      ]
    },
    "variants": {
      "type": "array",
      "description": "Changes the design allows without leaving the exact tier.",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "recolor",
              "material",
              "resize",
              "swap",
              "unknown"
            ]
          },
          "target": {
            "$ref": "common.schema.json#/$defs/Subject"
          },
          "allowed": {
            "description": "List of allowed values, or {min, max} for resize."
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "asset.schema.json"
      }
    },
    "card": {
      "$ref": "#/$defs/DesignCard"
    },
    "licence": {
      "$ref": "provenance.schema.json#/$defs/Licence"
    },
    "provenance": {
      "$ref": "provenance.schema.json#/$defs/Provenance"
    },
    "own_enclosure": {
      "type": "boolean",
      "description": "true when the design ships its own case files. Exact and substitute builds keep that case; false means a generated blank case is used."
    },
    "prebuilt_firmware": {
      "type": "boolean",
      "description": "true when the design ships a binary that the firmware stage can serve as is (firmware.mode prebuilt)."
    }
  },
  "$defs": {
    "DesignCard": {
      "type": "object",
      "description": "Compact design summary for lists and the reuse card.",
      "required": [
        "design_id",
        "name"
      ],
      "properties": {
        "design_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "device_class": {
          "$ref": "vocab.schema.json#/$defs/DeviceClass"
        },
        "thumbnail_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "licence_spdx": {
          "type": "string"
        },
        "commercial_ok": {
          "$ref": "common.schema.json#/$defs/TriState"
        },
        "key_specs": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "common.schema.json#/$defs/KeySpec"
          }
        }
      }
    }
  }
}
