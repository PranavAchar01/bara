{
  "mcpServers": {
    "tangible-hardware": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "-m",
        "bara.hwci.mcp_server",
        "--root",
        "hardware/boards",
        "--policy",
        "hardware/policy.json"
      ],
      "env": {
        "PYTHONPATH": "server/src"
      }
    }
  }
}
